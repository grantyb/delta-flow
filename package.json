{
  "name": "delta-flow",
  "displayName": "Delta Flow",
  "description": "The directory diff viewer that lives where you already work: VS Code, Git, and Tower.",
  "version": "0.1.0",
  "publisher": "grantyb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grantyb/delta-flow.git"
  },
  "keywords": [
    "git",
    "diff",
    "directory diff",
    "tower",
    "changeset"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.delta-flow"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Only diffs the two temporary trees git/Tower provide; never runs code from the workspace."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deltaFlow",
          "title": "Delta Flow",
          "icon": "media/delta-flow.svg"
        }
      ]
    },
    "views": {
      "deltaFlow": [
        {
          "id": "deltaFlow.filters",
          "name": "Filters",
          "icon": "media/delta-flow.svg",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "deltaFlow.changes",
          "name": "Changed Files",
          "icon": "media/delta-flow.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "deltaFlow.installTowerIntegration",
        "title": "Install Tower Integration",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.diffWorkingTree",
        "title": "Diff Working Tree",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.openExternal",
        "title": "Open in External App",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.revealCounterpart",
        "title": "Reveal Renamed Counterpart",
        "category": "Delta Flow",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "deltaFlow.focusPathFilter",
        "title": "Focus Path Filter",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.focusSearch",
        "title": "Focus Change Search",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.hideModified",
        "title": "Hide Modified Files",
        "category": "Delta Flow",
        "icon": "$(diff-modified)"
      },
      {
        "command": "deltaFlow.showModified",
        "title": "Show Modified Files",
        "category": "Delta Flow",
        "icon": "$(diff-ignored)"
      },
      {
        "command": "deltaFlow.hideAdded",
        "title": "Hide Added Files",
        "category": "Delta Flow",
        "icon": "$(diff-added)"
      },
      {
        "command": "deltaFlow.showAdded",
        "title": "Show Added Files",
        "category": "Delta Flow",
        "icon": "$(diff-ignored)"
      },
      {
        "command": "deltaFlow.hideDeleted",
        "title": "Hide Deleted Files",
        "category": "Delta Flow",
        "icon": "$(diff-removed)"
      },
      {
        "command": "deltaFlow.showDeleted",
        "title": "Show Deleted Files",
        "category": "Delta Flow",
        "icon": "$(diff-ignored)"
      },
      {
        "command": "deltaFlow.hideRenamed",
        "title": "Hide Renamed / Copied Files",
        "category": "Delta Flow",
        "icon": "$(diff-renamed)"
      },
      {
        "command": "deltaFlow.showRenamed",
        "title": "Show Renamed / Copied Files",
        "category": "Delta Flow",
        "icon": "$(diff-ignored)"
      },
      {
        "command": "deltaFlow.collapseAll",
        "title": "Collapse All",
        "category": "Delta Flow",
        "icon": "$(collapse-all)"
      },
      {
        "command": "deltaFlow.expandAll",
        "title": "Expand All",
        "category": "Delta Flow",
        "icon": "$(expand-all)"
      },
      {
        "command": "deltaFlow.next",
        "title": "Next Changed File",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.previous",
        "title": "Previous Changed File",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.collapseOrParent",
        "title": "Collapse Folder or Go to Parent",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.expandOrChild",
        "title": "Expand Folder or Go to First Child",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.expandSubtree",
        "title": "Expand Folder Recursively",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.collapseSubtree",
        "title": "Collapse Folder Recursively",
        "category": "Delta Flow"
      }
    ],
    "keybindings": [
      {
        "command": "deltaFlow.next",
        "key": "down",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.previous",
        "key": "up",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.collapseOrParent",
        "key": "left",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.expandOrChild",
        "key": "right",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.collapseSubtree",
        "key": "shift+left",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.expandSubtree",
        "key": "shift+right",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.focusPathFilter",
        "key": "/",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.focusSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == deltaFlow.changes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deltaFlow.hideModified",
          "when": "view == deltaFlow.filters && deltaFlow.status.M",
          "group": "navigation@1"
        },
        {
          "command": "deltaFlow.showModified",
          "when": "view == deltaFlow.filters && !deltaFlow.status.M",
          "group": "navigation@1"
        },
        {
          "command": "deltaFlow.hideAdded",
          "when": "view == deltaFlow.filters && deltaFlow.status.A",
          "group": "navigation@2"
        },
        {
          "command": "deltaFlow.showAdded",
          "when": "view == deltaFlow.filters && !deltaFlow.status.A",
          "group": "navigation@2"
        },
        {
          "command": "deltaFlow.hideDeleted",
          "when": "view == deltaFlow.filters && deltaFlow.status.D",
          "group": "navigation@3"
        },
        {
          "command": "deltaFlow.showDeleted",
          "when": "view == deltaFlow.filters && !deltaFlow.status.D",
          "group": "navigation@3"
        },
        {
          "command": "deltaFlow.hideRenamed",
          "when": "view == deltaFlow.filters && deltaFlow.status.RC",
          "group": "navigation@4"
        },
        {
          "command": "deltaFlow.showRenamed",
          "when": "view == deltaFlow.filters && !deltaFlow.status.RC",
          "group": "navigation@4"
        },
        {
          "command": "deltaFlow.collapseAll",
          "when": "view == deltaFlow.changes && !deltaFlow.collapsed",
          "group": "navigation@1"
        },
        {
          "command": "deltaFlow.expandAll",
          "when": "view == deltaFlow.changes && deltaFlow.collapsed",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "deltaFlow.openExternal",
          "when": "view == deltaFlow.changes && viewItem =~ /^file/",
          "group": "navigation"
        },
        {
          "command": "deltaFlow.revealCounterpart",
          "when": "view == deltaFlow.changes && viewItem == fileMove",
          "group": "navigation@1"
        },
        {
          "command": "deltaFlow.expandSubtree",
          "when": "view == deltaFlow.changes && viewItem == folder",
          "group": "navigation@1"
        },
        {
          "command": "deltaFlow.collapseSubtree",
          "when": "view == deltaFlow.changes && viewItem == folder",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Delta Flow",
      "properties": {
        "deltaFlow.session": {
          "type": "object",
          "default": null,
          "description": "Internal: the LEFT/RIGHT temporary directories for the current diff session, injected by the Delta Flow launcher."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-star-activation"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
