{
  "name": "git-dir-diff",
  "displayName": "Git Directory Diff",
  "description": "A read-only git directory diff viewer, usable as an external diff tool (e.g. from Tower) via git difftool --dir-diff.",
  "version": "0.0.1",
  "publisher": "cactuslab",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "*"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Only diffs the two temporary trees git/Tower provide; never runs code from the workspace."
    }
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "gitDirDiff.changes",
          "name": "Changed Files",
          "visibility": "visible",
          "initialSize": 1000
        }
      ]
    },
    "commands": [
      {
        "command": "gitDirDiff.openExternal",
        "title": "Open in External App",
        "category": "Git Directory Diff"
      },
      {
        "command": "gitDirDiff.setFilter",
        "title": "Filter Paths",
        "category": "Git Directory Diff",
        "icon": "$(filter)"
      },
      {
        "command": "gitDirDiff.searchChanges",
        "title": "Search Changes",
        "category": "Git Directory Diff",
        "icon": "$(search)"
      },
      {
        "command": "gitDirDiff.clearFilters",
        "title": "Filter: Clear",
        "category": "Git Directory Diff",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitDirDiff.collapseAll",
        "title": "Collapse All",
        "category": "Git Directory Diff",
        "icon": "$(collapse-all)"
      },
      {
        "command": "gitDirDiff.expandAll",
        "title": "Expand All",
        "category": "Git Directory Diff",
        "icon": "$(expand-all)"
      },
      {
        "command": "gitDirDiff.next",
        "title": "Next Changed File",
        "category": "Git Directory Diff"
      },
      {
        "command": "gitDirDiff.previous",
        "title": "Previous Changed File",
        "category": "Git Directory Diff"
      },
      {
        "command": "gitDirDiff.expandSubtree",
        "title": "Expand Folder Recursively",
        "category": "Git Directory Diff"
      },
      {
        "command": "gitDirDiff.collapseSubtree",
        "title": "Collapse Folder Recursively",
        "category": "Git Directory Diff"
      }
    ],
    "keybindings": [
      {
        "command": "gitDirDiff.next",
        "key": "down",
        "when": "focusedView == gitDirDiff.changes"
      },
      {
        "command": "gitDirDiff.previous",
        "key": "up",
        "when": "focusedView == gitDirDiff.changes"
      },
      {
        "command": "gitDirDiff.collapseOrParent",
        "key": "left",
        "when": "focusedView == gitDirDiff.changes"
      },
      {
        "command": "gitDirDiff.expandOrChild",
        "key": "right",
        "when": "focusedView == gitDirDiff.changes"
      },
      {
        "command": "gitDirDiff.collapseSubtree",
        "key": "shift+left",
        "when": "focusedView == gitDirDiff.changes"
      },
      {
        "command": "gitDirDiff.expandSubtree",
        "key": "shift+right",
        "when": "focusedView == gitDirDiff.changes"
      },
      {
        "command": "gitDirDiff.setFilter",
        "key": "/",
        "when": "focusedView == gitDirDiff.changes"
      },
      {
        "command": "gitDirDiff.searchChanges",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == gitDirDiff.changes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitDirDiff.setFilter",
          "when": "view == gitDirDiff.changes",
          "group": "navigation@1"
        },
        {
          "command": "gitDirDiff.searchChanges",
          "when": "view == gitDirDiff.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitDirDiff.clearFilters",
          "when": "view == gitDirDiff.changes",
          "group": "navigation@3"
        },
        {
          "command": "gitDirDiff.collapseAll",
          "when": "view == gitDirDiff.changes && !gitDirDiff.collapsed",
          "group": "navigation@3"
        },
        {
          "command": "gitDirDiff.expandAll",
          "when": "view == gitDirDiff.changes && gitDirDiff.collapsed",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitDirDiff.openExternal",
          "when": "view == gitDirDiff.changes && viewItem == file",
          "group": "navigation"
        },
        {
          "command": "gitDirDiff.expandSubtree",
          "when": "view == gitDirDiff.changes && viewItem == folder",
          "group": "navigation@1"
        },
        {
          "command": "gitDirDiff.collapseSubtree",
          "when": "view == gitDirDiff.changes && viewItem == folder",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Directory Diff",
      "properties": {
        "gitDirDiff.session": {
          "type": "object",
          "default": null,
          "description": "Internal: the LEFT/RIGHT temporary directories for the current diff session, injected by the git-dir-diff launcher."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
