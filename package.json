{
  "name": "delta-flow",
  "displayName": "Delta Flow",
  "description": "The directory diff viewer that lives where you already work: VS Code, Git, and Tower.",
  "version": "0.1.0",
  "publisher": "grantyb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grantyb/delta-flow.git"
  },
  "keywords": [
    "git",
    "diff",
    "directory diff",
    "tower",
    "changeset"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.delta-flow",
    "onCommand:deltaFlow.installTowerIntegration",
    "onCommand:deltaFlow.diffWorkingTree"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Only diffs the two temporary trees git/Tower provide; never runs code from the workspace."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deltaFlow",
          "title": "Delta Flow",
          "icon": "media/delta-flow.svg"
        }
      ]
    },
    "views": {
      "deltaFlow": [
        {
          "id": "deltaFlow.changes",
          "name": "Changed Files"
        }
      ]
    },
    "commands": [
      {
        "command": "deltaFlow.installTowerIntegration",
        "title": "Install Tower Integration",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.diffWorkingTree",
        "title": "Diff Working Tree",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.openExternal",
        "title": "Open in External App",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.setFilter",
        "title": "Filter Paths",
        "category": "Delta Flow",
        "icon": "$(filter)"
      },
      {
        "command": "deltaFlow.searchChanges",
        "title": "Search Changes",
        "category": "Delta Flow",
        "icon": "$(search)"
      },
      {
        "command": "deltaFlow.clearFilters",
        "title": "Filter: Clear",
        "category": "Delta Flow",
        "icon": "$(clear-all)"
      },
      {
        "command": "deltaFlow.collapseAll",
        "title": "Collapse All",
        "category": "Delta Flow",
        "icon": "$(collapse-all)"
      },
      {
        "command": "deltaFlow.expandAll",
        "title": "Expand All",
        "category": "Delta Flow",
        "icon": "$(expand-all)"
      },
      {
        "command": "deltaFlow.next",
        "title": "Next Changed File",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.previous",
        "title": "Previous Changed File",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.expandSubtree",
        "title": "Expand Folder Recursively",
        "category": "Delta Flow"
      },
      {
        "command": "deltaFlow.collapseSubtree",
        "title": "Collapse Folder Recursively",
        "category": "Delta Flow"
      }
    ],
    "keybindings": [
      {
        "command": "deltaFlow.next",
        "key": "down",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.previous",
        "key": "up",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.collapseOrParent",
        "key": "left",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.expandOrChild",
        "key": "right",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.collapseSubtree",
        "key": "shift+left",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.expandSubtree",
        "key": "shift+right",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.setFilter",
        "key": "/",
        "when": "focusedView == deltaFlow.changes"
      },
      {
        "command": "deltaFlow.searchChanges",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == deltaFlow.changes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deltaFlow.setFilter",
          "when": "view == deltaFlow.changes",
          "group": "navigation@1"
        },
        {
          "command": "deltaFlow.searchChanges",
          "when": "view == deltaFlow.changes",
          "group": "navigation@2"
        },
        {
          "command": "deltaFlow.clearFilters",
          "when": "view == deltaFlow.changes",
          "group": "navigation@3"
        },
        {
          "command": "deltaFlow.collapseAll",
          "when": "view == deltaFlow.changes && !deltaFlow.collapsed",
          "group": "navigation@3"
        },
        {
          "command": "deltaFlow.expandAll",
          "when": "view == deltaFlow.changes && deltaFlow.collapsed",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "deltaFlow.openExternal",
          "when": "view == deltaFlow.changes && viewItem == file",
          "group": "navigation"
        },
        {
          "command": "deltaFlow.expandSubtree",
          "when": "view == deltaFlow.changes && viewItem == folder",
          "group": "navigation@1"
        },
        {
          "command": "deltaFlow.collapseSubtree",
          "when": "view == deltaFlow.changes && viewItem == folder",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Delta Flow",
      "properties": {
        "deltaFlow.session": {
          "type": "object",
          "default": null,
          "description": "Internal: the LEFT/RIGHT temporary directories for the current diff session, injected by the Delta Flow launcher."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-star-activation"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
