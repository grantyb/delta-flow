#!/usr/bin/env bash
#
# git difftool --dir-diff launcher for the Delta Flow VS Code extension.
#
# git invokes this once with the two temp trees:  delta-flow "$LOCAL" "$REMOTE"
# We open a VS Code window whose workspace settings carry the two paths, then
# block (via --wait) until the user closes it, so git keeps the temp trees alive.
#
# Set $DELTA_FLOW_CODE to override the VS Code CLI location.

set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: delta-flow <LEFT_DIR> <RIGHT_DIR>" >&2
  exit 2
fi

# Tower and other GUI clients run with a minimal PATH, so probe known locations.
find_code() {
  local candidate
  for candidate in "${DELTA_FLOW_CODE:-}" code /usr/local/bin/code \
    "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"; do
    if [[ -n "$candidate" ]] && command -v "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  echo "error: could not find the VS Code CLI; set DELTA_FLOW_CODE" >&2
  return 1
}

code_bin="$(find_code)"

# Without --dir-diff, git invokes us once per file. Fall back to a plain diff so
# this tool is safe to set as the global diff.tool.
open_dir_diff() {
  local left right workdir workspace
  left="$(cd "$1" && pwd)"
  right="$(cd "$2" && pwd)"

  # An empty scratch folder anchors the workspace so --wait reliably holds the
  # window open; the diff paths ride in workspace settings.
  workdir="$(mktemp -d "${TMPDIR:-/tmp}/delta-flow.XXXXXX")"
  workspace="$workdir/session.code-workspace"
  # Expand $workdir now so cleanup works even though it is function-local.
  trap "rm -rf '$workdir'" EXIT

  # A single empty named folder anchors the workspace (a zero-folder workspace
  # shows a large "No Folder Opened" placeholder). The folder is empty and its
  # workspace file is hidden, so the Explorer shows only our Changed Files view.
  cat > "$workspace" <<EOF
{
  "folders": [{ "path": ".", "name": "Delta Flow" }],
  "settings": {
    "deltaFlow.session": { "left": "$left", "right": "$right" },
    "workbench.startupEditor": "none",
    "explorer.openEditors.visible": 0,
    "workbench.editor.enablePreview": true,
    "files.exclude": { "session.code-workspace": true, ".delta-flow": true }
  }
}
EOF

  # Marker that scopes the extension's activationEvents to Delta Flow windows only.
  touch "$workdir/.delta-flow"

  "$code_bin" --new-window --wait "$workspace"
}

if [[ -d "$1" && -d "$2" ]]; then
  open_dir_diff "$1" "$2"
else
  "$code_bin" --diff --wait "$1" "$2"
fi
